digraph SecuenciaSolve {
  graph [rankdir=TB, bgcolor="transparent", fontname="Segoe UI", pad=0.2, ranksep=0.45];
  node [shape=box, style="rounded,filled", fontname="Segoe UI", fontsize=10, color="#315A88", fillcolor="#F7FAFD"];
  edge [fontname="Segoe UI", fontsize=9, color="#52677D"];
  form [label="TestForm"];
  solve [label="1. SolucionadorTSP::solve"];
  validate [label="2. validateMetrica"];
  routes [label="3. generarRutasCanonicas"];
  evaluate [label="4. evaluateRuta por candidato\nhasConexion + getPeso"];
  count [label="5. Contar validos\ny conservar todas las evaluaciones"];
  best [label="6. Comparacion estricta <\nconserva primer empate"];
  result [label="7. ResultadoTSP"];
  form -> solve -> validate -> routes -> evaluate -> count -> best -> result;
  result -> form [style=dashed, label="candidatos, validos y optimo"];
}
