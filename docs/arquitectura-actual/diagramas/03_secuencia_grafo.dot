digraph SecuenciaGrafo {
  graph [rankdir=TB, bgcolor="transparent", fontname="Segoe UI", pad=0.2, ranksep=0.45];
  node [shape=box, style="rounded,filled", fontname="Segoe UI", fontsize=10, color="#315A88", fillcolor="#F7FAFD"];
  edge [fontname="Segoe UI", fontsize=9, color="#52677D"];
  usuario [label="TestForm"];
  constructor [label="1. Grafo(5)\nvalida 5..10"];
  add [label="2. addConexion(0,1,d,t,c)\nvalida indices, lazo y pesos"];
  simetria [label="3. conexiones[0][1] = conexiones[1][0]"];
  consulta [label="4. hasConexion / getPeso / getConexion"];
  matrices [label="5. getMatrizAdyacencia / getMatrizPesos\ncrea copias derivadas"];
  usuario -> constructor -> add -> simetria -> consulta -> matrices;
  matrices -> usuario [label="resultados sin modificar el grafo", style=dashed];
}
