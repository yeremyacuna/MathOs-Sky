digraph SecuenciaDiagnostico {
  graph [rankdir=TB, bgcolor="transparent", fontname="Segoe UI", pad=0.2, ranksep=0.45];
  node [shape=box, style="rounded,filled", fontname="Segoe UI", fontsize=10, color="#315A88", fillcolor="#F7FAFD"];
  edge [fontname="Segoe UI", fontsize=9, color="#52677D"];
  form [label="TestForm"];
  analyze [label="1. DiagnosticoHamiltoniano::analyze"];
  routes [label="2. generarRutasCanonicas"];
  inspect [label="3. Inspeccionar cada conexion\ncon hasConexion"];
  normalize [label="4. Normalizar (menor, mayor)\ny evitar duplicados"];
  select [label="5. Elegir minimo de faltantes\ncomparacion estricta"];
  result [label="6. ResultadoDiagnosticoHamiltoniano"];
  form -> analyze -> routes -> inspect -> normalize -> select -> result;
  result -> form [style=dashed, label="ruta sugerida y faltantes"];
}
