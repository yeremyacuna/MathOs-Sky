digraph UML {
  graph [rankdir=LR, bgcolor="transparent", fontname="Segoe UI", pad=0.25, nodesep=0.4, ranksep=0.7];
  node [shape=record, style="filled", fontname="Segoe UI", fontsize=9.5, color="#315A88", fillcolor="#F7FAFD"];
  edge [fontname="Segoe UI", fontsize=8.5, color="#52677D", arrowsize=0.75];

  Metrica [label="{enum Metrica|Distancia\lTiempo\lCosto\l}", fillcolor="#FFF8E1"];
  Conexion [label="{struct Conexion|existe: bool\ldistancia: double\ltiempo: double\lcosto: double\l}"];
  Grafo [label="{class Grafo|- conexiones: vector\l|+ Grafo(cantidadNodos)\l+ addConexion(...)\l+ removeConexion(...)\l+ hasConexion(...)\l+ getConexion(...)\l+ getPeso(...)\l+ getMatrizAdyacencia()\l+ getMatrizPesos(...)\l}", fillcolor="#EAF2FB"];
  Ruta [label="{struct RutaEvaluada|ruta: vector<int>\lvalida: bool\lvalorTotal: double\l}"];
  Resultado [label="{struct ResultadoTSP|rutas: vector<RutaEvaluada>\lmejorRuta: vector<int>\lmejorValor: double\lcantidadCandidatos: size_t\lcantidadCiclosValidos: size_t\l}"];
  Paso [label="{struct PasoConexionTSP|indiceConexion: size_t\lorigen: int\ldestino: int\lconexionExiste: bool\lpeso: double\lvalorAcumulado: double\l}"];
  Traza [label="{struct TrazaRutaTSP|ruta: vector<int>\lpasos: vector<PasoConexionTSP>\lvalida: bool\lvalorTotal: double\l}"];
  Faltante [label="{struct ConexionFaltante|origen: int\ldestino: int\l}"];
  ResDiag [label="{struct ResultadoDiagnosticoHamiltoniano|existeCicloHamiltoniano: bool\lrutaSugerida: vector<int>\lconexionesFaltantes: vector<ConexionFaltante>\l}"];
  Solver [label="{class SolucionadorTSP|- validateMetrica(...)\l- validateEstructuraRuta(...)\l- evaluateRuta(...)\l|+ solve(...) : ResultadoTSP\l+ traceRuta(...) : TrazaRutaTSP\l}", fillcolor="#E8F5E9"];
  Diagnostico [label="{class DiagnosticoHamiltoniano|- findConexionesFaltantes(...)\l|+ analyze(...) : ResultadoDiagnosticoHamiltoniano\l}", fillcolor="#E8F5E9"];
  TestForm [label="{ref class TestForm|controles Windows Forms\lcontadores PASS/FAIL\l|- inicializarSelecciones()\l- manejadores de pestañas\l- btnEjecutarTodas_Click(...)\l}", fillcolor="#F3E5F5", color="#7B4B94"];

  Grafo -> Conexion [label="composicion matricial", arrowhead=diamond];
  Grafo -> Metrica [label="selecciona peso", style=dashed];
  Resultado -> Ruta [label="contiene", arrowhead=diamond];
  Traza -> Paso [label="contiene", arrowhead=diamond];
  ResDiag -> Faltante [label="contiene", arrowhead=diamond];
  Solver -> Grafo [label="usa const&", style=dashed];
  Solver -> Resultado [label="produce", style=dashed];
  Solver -> Traza [label="produce", style=dashed];
  Diagnostico -> Grafo [label="usa const&", style=dashed];
  Diagnostico -> ResDiag [label="produce", style=dashed];
  TestForm -> Grafo [label="construye pruebas", style=dashed];
  TestForm -> Solver [label="invoca", style=dashed];
  TestForm -> Diagnostico [label="invoca", style=dashed];
}
